%% 销售订单系统 — 「订单→工单」增量 类图
%% ★ 为本增量新增成员；其余为既有代码（保留仅列出与本增量相关部分）

classDiagram
    class Order {
        +id: string
        +orderNo: string
        +workOrderNo: string  ★
        +status: 'pending'|'appointed'|'deal'|'collected'|'noshow'  ★
        +custName: string
        +custPhone: string
        +custCity: string
        +custProduct: string
        +custNote: string
        +store: string  ★
        +amountLive: number|null  ★
        +amountSupply: number|null  ★
        +amountProfit: number|null  ★
        +collected: boolean  ★
        +collectedAt: string|null  ★
        +visitStatus: string|null
        +dealStatus: string|null
        +dealLiveAmount: number
        +dealSupplyAmount: number
        +dealProfit: number
        +dealAmount: number
        +dealAt: string|null
        +createdAt: string
    }
    class Store {
        +id: string
        +city: string  ★标准化短名
        +name: string
    }
    class User {
        +id: string
        +username: string
        +password: string
        +role: 'admin'|'sales'|'finance'|'finance_collect'
        +name: string
        +phone: string
    }
    class ServerModule {
        <<server.js>>
        +DATA_COLLECTIONS: string[]
        +nextWorkOrderNo(orders, bjDateKey) string  ★
        +deriveStatus(order) string  ★ 权威推导规则(单一事实来源)
        +normalizeCityName(raw) string  ★
        +seedCloudDefaultStores(db) Promise~void~  ★
        +putVisit(req,res) ★
        +putNoShow(req,res) ★
        +putCollect(req,res) ★
        +putPrice(req,res) ★
        +storesCrud(req,res) ★
    }
    class StorageLayer {
        <<existing: server.js>>
        +readAll(name) Promise~Array~
        +readAllPaged(name) Promise~Array~
        +addItem(name, item) Promise~string~
        +updateItem(name, id, updates) Promise~void~
        +removeItem(name, id) Promise~void~
        +findById(name, id) Promise~object~
    }
    class WorkbenchUI {
        <<index.html>>
        +statusOf(order) string ★ 与 server.deriveStatus 同一份规则
        +renderWorkOrders() ★
        +appointWorkOrder(oid) ★ 一键预约+复制六要素
        +openArriveModal(oid) ★
        +confirmCollect(oid) ★
        +savePrice(oid) ★ 失焦自动保存
        +renderStores() ★
    }
    ServerModule ..> StorageLayer : uses
    ServerModule ..> Order : 读写
    ServerModule ..> Store : 读写
    WorkbenchUI ..> ServerModule : fetch
